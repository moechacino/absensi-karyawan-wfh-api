# Copy to .env.docker. Never commit the populated file.
# Use independent random hex secrets for the four password/secret values.
DB_NAME=absensi_wfh
DB_USERNAME=absensi_wfh
DB_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_ROOT_PASSWORD

# Published only on loopback, avoiding the server's existing MariaDB on 3306.
MYSQL_PORT=3307
PORT=3000
ATTENDANCE_RPC_PORT=4001
ATTENDANCE_RPC_DEADLINE_MS=5000

JWT_SECRET=REPLACE_WITH_RANDOM_JWT_SECRET_OF_AT_LEAST_32_BYTES
JWT_ISSUER=absensi-wfh-api
JWT_AUDIENCE=absensi-wfh-web
ATTENDANCE_RPC_CREDENTIAL=REPLACE_WITH_DIFFERENT_RANDOM_RPC_SECRET_OF_AT_LEAST_32_BYTES
CORS_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com

DB_POOL_SIZE=10
MAX_CONCURRENT_UPLOADS=4
IDEMPOTENCY_RETENTION_SECONDS=86400
