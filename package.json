{
  "name": "absensi-karyawan-wfh-api",
  "version": "0.0.1",
  "description": "NestJS API for Absensi Karyawan WFH",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "oxlint --type-aware src/ test/",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "test:debug": "node --inspect-brk --experimental-vm-modules -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.json",
    "test:integration": "node --env-file-if-exists=.env.test.local --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./test/jest-integration.json --runInBand",
    "typeorm": "node --env-file-if-exists=.env ./node_modules/typeorm/cli.js",
    "premigration:generate": "npm run build",
    "migration:generate": "npm run typeorm -- migration:generate -d dist/database/cli-data-source.js",
    "premigration:show": "npm run build",
    "migration:show": "npm run typeorm -- migration:show -d dist/database/cli-data-source.js",
    "premigration:run": "npm run build",
    "migration:run": "npm run typeorm -- migration:run -d dist/database/cli-data-source.js",
    "premigration:revert": "npm run build",
    "migration:revert": "npm run typeorm -- migration:revert -d dist/database/cli-data-source.js",
    "migration:create": "npm run typeorm -- migration:create",
    "test:unit": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./jest.config.ts --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "12.3.3",
    "@nestjs/core": "12.3.3",
    "@nestjs/jwt": "12.0.4",
    "@nestjs/platform-express": "12.3.3",
    "@nestjs/typeorm": "12.0.3",
    "argon2": "0.45.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "mysql2": "3.24.6",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "typeorm": "1.1.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.12",
    "@nestjs/schematics": "12.0.12",
    "@nestjs/testing": "12.3.3",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2006",
    "prettier": "3.9.10",
    "source-map-support": "0.5.21",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=26.13.0 <27",
    "npm": ">=11.20.0 <12"
  },
  "packageManager": "npm@11.20.0",
  "allowScripts": {
    "argon2@0.45.2": true,
    "@parcel/watcher@2.6.0": true
  }
}
