# Copy to .env and replace secrets. Never commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Connect directly to your native MySQL service.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=absensi_wfh
DB_USERNAME=absensi_wfh
DB_PASSWORD=REPLACE_WITH_A_LOCAL_DATABASE_PASSWORD
DB_POOL_SIZE=10
DB_CONNECT_TIMEOUT_MS=10000

# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_ALGORITHM=HS256
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
JWT_ISSUER=absensi-wfh-api
JWT_AUDIENCE=absensi-wfh-web
JWT_ACCESS_TTL_SECONDS=28800

# Independent settings; task 004 will wire the HTTP protections.
CORS_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Relative paths resolve from api-server/. Keep bytes outside this application.
STORAGE_ROOT=../.local/absensi-wfh/files
MAX_FILE_BYTES=5242880
MAX_CONCURRENT_UPLOADS=4
BUSINESS_TOKEN_TTL_SECONDS=600
IDEMPOTENCY_RETENTION_SECONDS=86400
